# ── Copy this file to .env and fill in your values ──────────
# NEVER commit .env to git

NODE_ENV=production
PORT=4000

# MySQL (your remote database)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=bki_cms
DB_USER=bki_user
DB_PASSWORD=your-db-password

# JWT — generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex-string
JWT_EXPIRES_IN=24h

# CORS — your production domain
CORS_ORIGIN=https://bki2.pacificpact.com
